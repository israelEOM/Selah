# Worker configuration. Copy to .env and fill in.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: rotating residential proxy for YouTube captions (not needed on a home connection).
YOUTUBE_PROXY_URL=
# YouTube Data API v3 key. Needed to search channels and list their lives on the
# import page; also adds the official duration and date. Pasting a link works without it.
YOUTUBE_API_KEY=
